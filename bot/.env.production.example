# متغيرات البيئة للإنتاج على Render
# هذه القيم ستُحدد في Render Dashboard تحت Environment Variables

# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Database Connection
# استخدم رابط قاعدة البيانات من Render PostgreSQL أو YugabyteDB Managed
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# SSL Certificate Path (مطلوب فقط إذا كنت تستخدم sslmode=verify-full)
DB_SSL_CA_PATH=/app/certs/root.crt

# Dashboard URL (حدّث هذا بعد نشر الـ Dashboard) — يُستخدم في روابط صفحة التحميل ,dw
DASHBOARD_URL=https://your-dashboard-url.onrender.com

# مفاتيح اختيارية: بدونها تتعطّل الميزة المعنية فقط (لا تتوقف جميع المزايا)
# TMDB_API_KEY=
# OMDB_API_KEY=
# DEEPL_API_KEY=

# سر توقيع روابط التحميل — يجب أن يطابق نفس القيمة في اللوحة.
# يمكن الاستغناء عنه باستخدام NEXTAUTH_SECRET (نفس الخدمة على Render).
DOWNLOADER_SECRET=

# معرّف مالك لوحة التحكم (اختياري — بدونه يُستخدم المعرّف الافتراضي في الكود)
OWNER_ID=

# اختياري: معرف السيرفر للتطوير (لا تستخدمه في الإنتاج)
# DEV_GUILD_ID=
