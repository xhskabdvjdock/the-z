# متغيرات البيئة للإنتاج على Render
# هذه القيم ستُحدد في Render Dashboard تحت Environment Variables

# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Database Connection
# استخدم رابط قاعدة البيانات من Render PostgreSQL أو YugabyteDB Managed
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# SSL Certificate Path (مطلوب فقط إذا كنت تستخدم sslmode=verify-full)
DB_SSL_CA_PATH=/app/certs/root.crt

# Dashboard URL (حدّث هذا بعد نشر الـ Dashboard)
DASHBOARD_URL=https://your-dashboard-url.onrender.com

# اختياري: معرف السيرفر للتطوير (لا تستخدمه في الإنتاج)
# DEV_GUILD_ID=
