# ============================================================
# متغيرات بيئة لوحة التحكم (انسخ هذا الملف إلى .env.local)
# ============================================================

# تطبيق Discord (نفس القيم المستخدمة في البوت)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# توكن البوت — يُستخدم لقراءة السيرفرات/الأعضاء/الرولات في اللوحة
DISCORD_BOT_TOKEN=

# مفتاح تشفير جلسات NextAuth (ولّده بـ: openssl rand -base64 32)
NEXTAUTH_SECRET=
# عنوان اللوحة نفسه (في الإنتاج: رابط الخدمة على Render)
NEXTAUTH_URL=http://localhost:3000

# قاعدة البيانات (نفس DATABASE_URL المستخدم في البوت)
DATABASE_URL=postgresql://user:password@host:5433/dbname?sslmode=verify-full
DB_SSL_CA_PATH=../certs/root.crt

# اختياري: Redis للبيانات المؤقتة (بدونه يعمل النظام على ذاكرة العملية)
REDIS_URL=

# ============================================================
# اختياري
# ============================================================

# معرّف مالك لوحة التحكم — يمنح وصولاً كاملاً دائمًا ويُقارَن مع القائمة البيضاء.
# بدونه يُستخدم المعرّف الافتراضي المضمّن في الكود.
OWNER_ID=

# سر توقيع روابط التحميل (,dw). إن لم يُضبط، تُستخدم قيم NEXTAUTH_SECRET ثم
# DISCORD_CLIENT_SECRET تلقائيًا. عند غيابها جميعًا يصبح التحميل متاحًا لجلسات
# لوحة التحكم المصرّح لها فقط.
DOWNLOADER_SECRET=

# ضبط واجهة التحميل
# DOWNLOADER_TEMP_DIR=/tmp/the-z-downloads   # مجلد الملفات المؤقتة
# DOWNLOADER_MAX_FILE_SIZE_MB=100            # أقصى حجم ملف
# DOWNLOADER_TIMEOUT_SECONDS=60              # مهلة تنزيل yt-dlp
# DOWNLOADER_MAX_CONCURRENCY=2               # أقصى عدد تحميلات متزامنة
# INSTAGRAM_COOKIES_PATH=/app/certs/instagram_cookies.txt  # كوكيز انستغرام عند الحاجة
